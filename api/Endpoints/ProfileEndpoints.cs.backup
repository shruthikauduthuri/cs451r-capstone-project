using System;
using System.Linq;
using System.Threading.Tasks;
using api.Contracts.Profile;
using api.Models;
using Supabase;
using Microsoft.Extensions.Logging;

namespace api.Endpoints
{
    public static class ProfileEndpoints
    {
        public static void MapProfileEndpoints(this IEndpointRouteBuilder app)
        {
            app.MapGet("/api/profile/me", async (Client supabase) =>
            {
                var user = supabase.Auth.CurrentUser;
                if (user == null)
                {
                    return Results.Unauthorized();
                }

                if (string.IsNullOrWhiteSpace(user.Id) || !long.TryParse(user.Id, out var userProfileId))
                {
                    return Results.BadRequest("Invalid user ID");
                }

                var profileResponse = await supabase.From<Profile>()
                    .Where(p => p.Id == user.Id)
                    .Get();

                var profile = profileResponse.Models?.FirstOrDefault();
                if (profile == null)
                {
                    return Results.NotFound("Profile not found");
                }

                return Results.Ok(profile);
            });

            app.MapPut("/api/profile/me", async (Client supabase, UpdateProfileRequest request) =>
            {
                var user = supabase.Auth.CurrentUser;
                if (user == null)
                {
                    return Results.Unauthorized();
                }

                if (string.IsNullOrWhiteSpace(user.Id))
                {
                    return Results.BadRequest("Invalid user ID");
                }

                await supabase.From<Profile>()
                    .Where(p => p.Id == user.Id)
                    .Set(p => p.UserName, request.DisplayName)
                    .Update();

                return Results.Ok();
            });

            app.MapPost("/api/profile/transition", async (Client supabase) =>
            {
                var user = supabase.Auth.CurrentUser;
                if (user == null)
                {
                    return Results.Unauthorized();
                }

                if (string.IsNullOrWhiteSpace(user.Id))
                {
                    return Results.BadRequest("Invalid user ID");
                }


                var profileResponse = await supabase.From<Profile>()
                    .Where(p => p.Id == user.Id)
                    .Get();

                var profile = profileResponse.Models?.FirstOrDefault();
                if (profile == null)
                {
                    return Results.NotFound("Profile not found");
                }

                if (profile.HouseholdId == null)
                {
                    return Results.Ok("Profile is already individual");
                }

                await supabase.From<Profile>()
                    .Where(p => p.Id == user.Id)
                    .Set(p => p.HouseholdId!, null)
                    .Set(p => p.Role, string.Empty)
                    .Update();

                return Results.Ok("Account transitioned");
            });
        }
    }
}
